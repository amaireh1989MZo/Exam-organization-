{
  "QuestionBank": {
    "SourceRoot": "\\\\FILESERVER\\QuestionBankReadOnly",
    "OutputRoot": "\\\\FILESERVER\\QuestionBankOutput",
    "BatchSize": 100,
    "MaxRetries": 3,
    "RetryBaseDelaySeconds": 5,
    "ScanOnStartup": false,
    "EnableWorker": true,
    "Uploads": {
      "MaxFileSizeMb": 50,
      "AllowedExtensions": [ "docx", "xlsx", "xls", "doc", "pdf", "txt", "md", "gift" ]
    }
  },
  "ConnectionStrings": {
    "QuestionBank": "Data Source=App_Data/questionbank.db"
  },
  "Authentication": {
    "Mode": "Windows"
  },
  "Authorization": {
    "Roles": {
      "Admin": [ "CORP\\QB-Admins" ],
      "BankManager": [ "CORP\\QB-BankManagers" ],
      "Reviewer": [ "CORP\\QB-Reviewers" ],
      "Viewer": [ "CORP\\QB-Viewers" ]
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "qbank.local;localhost"
}
